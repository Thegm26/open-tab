# Local demos use in-memory storage when this is omitted.
NEXT_PUBLIC_APP_URL=http://localhost:3000
OPEN_TAB_CREDENTIAL_SECRET=replace-with-at-least-32-random-bytes
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required only for local demo/test runs; production fails closed without Supabase.
OPEN_TAB_ALLOW_IN_MEMORY=true
# Optional authenticated proxy contract: proxy sends identity plus HMAC-SHA256
# signature over `${operation}:${identity}` using this server-only secret.
OPEN_TAB_TRUSTED_PROXY_IP_HEADER=
OPEN_TAB_TRUSTED_PROXY_SIGNATURE_HEADER=
OPEN_TAB_TRUSTED_PROXY_HMAC_SECRET=
